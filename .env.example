TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.1-mini
GROUP_CHAT_ID=-1001234567890
INITIATIVE_ENABLED=true
INITIATIVE_INTERVAL_MINUTES=60
DB_PATH=data/bot.sqlite3
# Must exactly match SECRET in google_apps_script/Code.gs
GOOGLE_NEWBIE_SECRET=change_me_to_a_long_random_secret
# Full deployed Apps Script Web App URL ending with /exec
GOOGLE_NEWBIE_WEBHOOK=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
